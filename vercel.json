{
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/recompute-matches",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/notify-matches",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/downgrade-expired",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/snapshot-network",
      "schedule": "0 23 * * 6"
    },
    {
      "path": "/api/cron/renotify",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/meetup-feed",
      "schedule": "0 8 * * *"
    }
  ]
}
